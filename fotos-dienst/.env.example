# Einstellungen für setup.sh und start-lokal.sh.
# Kopieren nach .env und ausfüllen:   cp .env.example .env
# .env ist von Git ausgeschlossen – dort dürfen die echten Passwörter stehen.

# Google-Cloud-Projekt (Projekt-ID, nicht der Name)
PROJEKT=tunesien-2026-fotos

# Adresse der Reiseseite auf GitHub Pages (mit / am Ende)
SEITE=https://dein-name.github.io/tunesien-2026/

# Passwörter der Reisegruppen: mindestens 4 Zeichen, ohne Leerzeichen, Komma und @,
# Groß-/Kleinschreibung zählt nicht. Leer lassen = setup.sh fragt danach.
PASSWORT_TRAVEL_OPEN=
PASSWORT_SCHWARZ_GEGEN_ROT=

# Optional
#REGION=europe-west3
#BUCKET=tunesien-2026-fotos-fotos
